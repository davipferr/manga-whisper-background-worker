# Environment Variables Template
# Copy this file to .env for local development

# Database Connection (Same database as main MangaWhisper API)
DefaultConnection=Host=localhost;Database=mangawhisper;Username=postgres;Password=yourpassword;Port=5432

# Background Service Configuration
# Days of week to run (comma-separated): 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday
# Example: "1,3,5" runs on Monday, Wednesday, and Friday
CHECK_DAYS_OF_WEEK=4,5
# Start hour in BRT (24-hour format, 0-23)
CHECK_START_HOUR=12
# Interval between checks in hours
CHECK_INTERVAL_HOURS=4
