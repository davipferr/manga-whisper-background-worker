# Environment Variables Template
# Only needed to run the worker outside Docker (e.g. debugging with `dotnet run`).
# Copy this file to .env. With Docker, the values come from manga-whisper/.env instead.
# The schedule is not configured here: jobs are created in the admin panel and stored in the database.

# Database Connection (Same database as main MangaWhisper API; values match manga-whisper/.env.example)
DefaultConnection=Host=localhost;Database=manga_whisper;Username=postgres;Password=postgres;Port=5432
